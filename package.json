{
  "name": "fight-club",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-pwa-assets": "pwa-assets-generator",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run --exclude \"tests/rules/**\" --exclude \"e2e/**\"",
    "test:watch": "vitest --exclude \"tests/rules/**\" --exclude \"e2e/**\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-fight-club \"vitest run -c vitest.rules.config.ts\"",
    "test:e2e": "tsc -b && vite build --mode e2e && firebase emulators:exec \"tsx e2e/seed.ts && playwright test\"",
    "emulators": "firebase emulators:start --import=.emulator-data --export-on-exit=.emulator-data",
    "seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_PROJECT_ID=fight-club-4de90 npm run job -- jobs/seed-emulator.ts",
    "deploy:rules": "firebase deploy --only firestore",
    "job": "tsx --env-file-if-exists=.env.local",
    "jobs:hello": "npm run job -- jobs/hello.ts",
    "jobs:ingest": "npm run job -- jobs/ingest-events.ts",
    "jobs:odds": "npm run job -- jobs/ingest-odds.ts",
    "jobs:lifecycle": "npm run job -- jobs/lifecycle.ts",
    "bootstrap:admin": "npm run job -- jobs/bootstrap-admin.ts"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
